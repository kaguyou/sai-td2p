     SOC_IF_ERROR_RETURN(soc_td2_port_lls_init(unit, port, 
                                               _td2_cpu_port_lls_config[unit], setup,
@@ -2330,6 +2336,9 @@
         }
 
         pcb->lock = sal_mutex_create("td2plus_dyn_lock");
