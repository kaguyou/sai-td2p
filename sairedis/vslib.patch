@@ -121,6 +121,17 @@ sai_status_t VirtualSwitchSaiInterface::flushFdbEntries(
 
     auto ss = m_switchStateMap.at(switch_id);
 
+    // hardware switch: drop the same entries from the ASIC L2 table, otherwise
+    // they are never re-learned and SONiC's view stays empty
+    {
+        sai_status_t hw = ss->hwFlushFdbEntries(attr_count, attr_list);
+
+        if (hw != SAI_STATUS_SUCCESS)
+        {
+            SWSS_LOG_WARN("hwFlushFdbEntries failed: %s", sai_serialize_status(hw).c_str());
+        }
+    }
+
     // TODO move some part to switch state
     auto &fdbs = ss->m_objectHash.at(SAI_OBJECT_TYPE_FDB_ENTRY);
 
