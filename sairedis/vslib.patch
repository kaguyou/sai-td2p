+# hwbcm/*.c wrap the OpenBCM SDK (BCM56860 hardware switch). They need the SDK
+# defines and include paths, kept in ../sai-td2p next to this tree (see
+# sai-td2p/DESIGN.md). The SDK static libraries are added at link time by the
+# deploy scripts (LIBS override), not here.
+SDK_CFLAGS = $(shell cat $(top_srcdir)/../sai-td2p/sdk_cflags.txt $(top_srcdir)/../sai-td2p/sdk_incs.txt 2>/dev/null)
