@@ -152,6 +152,31 @@ sai_status_t Sai::apiInitialize(
 
     auto useTapDevice = SwitchConfig::parseBool(use_tap_dev);
 
+    // hardware switch: packets go through KNET netdevs, never through tap/veth
+
+    std::string initConfigFile;
+
+    if (switchType == SAI_VS_SWITCH_TYPE_BCM56860HW)
+    {
+        if (useTapDevice)
+        {
+            SWSS_LOG_WARN("%s is true but switch type is %s, forcing tap devices OFF",
+                    SAI_KEY_VS_HOSTIF_USE_TAP_DEVICE,
+                    SAI_VALUE_VS_SWITCH_TYPE_BCM56860HW);
+
+            useTapDevice = false;
+        }
+
+        const char *init_config_file = service_method_table->profile_get_value(0, SAI_KEY_INIT_CONFIG_FILE);
+
+        if (init_config_file != NULL)
+        {
+            initConfigFile = init_config_file;
+        }
+
+        SWSS_LOG_NOTICE("%s = '%s'", SAI_KEY_INIT_CONFIG_FILE, initConfigFile.c_str());
+    }
+
     const char *bfd_offload_supported = service_method_table->profile_get_value(0, SAI_KEY_VS_BFD_OFFLOAD_SUPPORTED);
     auto bfdOffloadSupported = SwitchConfig::parseBfdOffloadSupported(bfd_offload_supported);
 
