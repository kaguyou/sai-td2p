+					  VirtualSwitchSaiInterfacePort.cpp \
+					  hwbcm/hwbcm_core.c \
+					  hwbcm/hwbcm_l2.c \
+					  hwbcm/hwbcm_l3.c \
+					  hwbcm/hwbcm_vxlan.c \
+					  hwbcm/hwbcm_stats.c \
+					  hwbcm/hwbcm_acl.c \
+					  hwbcm/hwbcm_copp.c \
+					  hwbcm/hwbcm_qos.c \
+					  hwbcm/hwbcm_mirror.c
+
+# hwbcm/*.c wrap the OpenBCM SDK (BCM56860 hardware switch). They need the SDK
+# defines and include paths, captured in the sai-td2p checkout (see
+# sai-td2p/DESIGN.md): sdk_cflags_wb.txt + sdk_incs_wb.txt for the warm-boot
+# SDK (sdk-6.5.27-wb, the default) or sdk_cflags.txt + sdk_incs.txt for the
+# cold-only SDK (SDK_FLAGS_SUFFIX=). sai-td2p/deploy/build.sh and build_wb.sh
+# always pass SDK_CFLAGS on the make line; these defaults only matter for a
+# plain `make`. The SDK static libraries are added at link time by the deploy
+# scripts (LIBS override), not here.
+SAI_TD2P_DIR = $(top_srcdir)/../sai-td2p
+SDK_FLAGS_SUFFIX = _wb
+SDK_CFLAGS = $(shell cat $(SAI_TD2P_DIR)/sdk_cflags$(SDK_FLAGS_SUFFIX).txt $(SAI_TD2P_DIR)/sdk_incs$(SDK_FLAGS_SUFFIX).txt 2>/dev/null)
+libSaiVS_a_CFLAGS = $(SDK_CFLAGS) -fPIC -I$(srcdir)/hwbcm
 
 if USE_VPP
 libSaiVS_a_SOURCES +=\
